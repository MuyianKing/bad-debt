<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 识别记录页「扫描其它应用」需要枚举已安装应用；仅本机使用，不联网。
         默认列表只查内置包名，不会在打开页面时触发该权限。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 无障碍自恢复：adb 授予后，App 可自行把无障碍服务补回系统启用列表 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- 后台保活前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 电池优化白名单 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="孽账"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Muyian">

        <activity
            android:name="com.muyian.debt.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Muyian"
            android:windowSoftInputMode="adjustResize" />

        <!-- 桌面图标跟随哪吒表情：三个 alias 互斥启用，由 data/LauncherIcon.kt 切换。
             MainActivity 不再自己声明 LAUNCHER，否则会同时出现两个图标。 -->
        <activity-alias
            android:name="com.muyian.debt.LauncherGrin"
            android:targetActivity="com.muyian.debt.MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="孽账"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.muyian.debt.LauncherCheer"
            android:targetActivity="com.muyian.debt.MainActivity"
            android:icon="@mipmap/ic_launcher_cheer"
            android:roundIcon="@mipmap/ic_launcher_cheer_round"
            android:label="孽账"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.muyian.debt.LauncherGrumpy"
            android:targetActivity="com.muyian.debt.MainActivity"
            android:icon="@mipmap/ic_launcher_grumpy"
            android:roundIcon="@mipmap/ic_launcher_grumpy_round"
            android:label="孽账"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 无障碍服务：用户授权后由系统 bind，采集支付结果页文本 -->
        <service
            android:name="muyian.bill.listener.MuyianBillAccessibilityService"
            android:exported="true"
            android:label="@string/muyian_acc_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/muyian_accessibility_config" />
        </service>

        <!-- 通知监听服务（辅助渠道） -->
        <service
            android:name="muyian.bill.listener.BillNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 支付后的底部确认弹层：透明 Activity，独立任务、不进最近任务。
             configChanges：转屏/折叠时重建会走 onDestroy 的未保存丢弃分支，
             用户正在编辑的账单会直接丢，所以自己处理配置变化不重建。 -->
        <activity
            android:name="muyian.bill.listener.BillSheetActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 钱迹导入的文件选择中转 Activity -->
        <activity
            android:name="muyian.bill.listener.ImportPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 备份导出的另存为中转 Activity -->
        <activity
            android:name="muyian.bill.listener.BackupSaveActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 后台保活前台服务 -->
        <service
            android:name="muyian.bill.listener.MuyianKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

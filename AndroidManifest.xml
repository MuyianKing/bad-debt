<?xml version="1.0" encoding="utf-8"?>
<!--
    云打包合并用的应用清单（HBuilderX 3.6+ 支持，根目录固定文件名 AndroidManifest.xml）。
    唯一的用途：把本应用的任务从系统「最近任务」列表隐藏，用户点「一键清理」时
    不会把本应用任务一起清掉，避免后台自动记账被连带杀死。

    约束：
    - 根节点必须有 android / tools 命名空间和非空 package，且与 manifest.json 的包名一致；
    - 这里只加 excludeFromRecents，禁止配置 theme / screenOrientation / configChanges /
      windowSoftInputMode / launchMode（DCloud 明确禁止，会引发不可预估的问题）；
    - 改动只在云端打包（或重做自定义调试基座）后生效，H5/标准基座看不到效果。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.muyian.app">

    <application>
        <!--
            启动入口：正式包里的 LAUNCHER Activity 是 io.dcloud.PandoraEntry，
            它才是任务的根，excludeFromRecents 必须挂在根 Activity 上才生效。
        -->
        <activity
            android:name="io.dcloud.PandoraEntry"
            android:excludeFromRecents="true" />

        <!-- 页面载体：个别启动路径会以它为任务根，一并隐藏，避免漏网 -->
        <activity
            android:name="io.dcloud.PandoraEntryActivity"
            android:excludeFromRecents="true" />
    </application>

</manifest>

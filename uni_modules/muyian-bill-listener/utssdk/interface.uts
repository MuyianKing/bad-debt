/**
 * muyian-bill-listener 对外 API 声明
 *
 * 约定：所有复杂数据以 JSON 字符串进出，页面侧自行 JSON.parse，
 * 以避免 UTS(number) 与 Kotlin(Int/Double) 的类型映射问题。
 * 金额规则：支出为负数、收入为正数（与账单库一致）。
 */

/** 初始化：清理旧版本遗留状态并拉起后台保活。在 App onLaunch 调用一次 */
export function initBillListener(): void

/** 检测用户是否已在系统设置中开启本应用的无障碍服务 */
export function isAccessibilityEnabled(): boolean

/** 跳转到系统的"无障碍"设置页 */
export function openAccessibilitySettings(): void

/** 自恢复状态查询，返回 {"hasPermission":bool,"serviceEnabled":bool,"packageName":"..."} JSON 字符串 */
export function getSelfRepairState(): string

/** 无障碍服务自恢复：把本应用服务补回系统已启用列表（需 WRITE_SECURE_SETTINGS），返回 {"success":bool,"serviceEnabled":bool,"error"?:string} JSON 字符串 */
export function repairAccessibilityService(): string

/** [辅助渠道] 检测"通知使用权"授权状态，覆盖收款到账提醒、碰卡交易通知等场景 */
export function isNotificationListenerEnabled(): boolean

/** [辅助渠道] 跳转到系统的"通知使用权"授权页 */
export function openNotificationListenerSettings(): void

/** 系统是否允许本应用发通知（Android 13+ 含 POST_NOTIFICATIONS 运行时权限） */
export function areNotificationsEnabled(): boolean

/** 后台保活是否开启（前台服务常驻，默认开启） */
export function isKeepAliveEnabled(): boolean

/** 开启/关闭后台保活前台服务，返回是否设置成功 */
export function setKeepAliveEnabled(enabled: boolean): boolean

/** 系统"显示在其他应用上层"（SYSTEM_ALERT_WINDOW）是否已允许；弹层是 Activity，不用它绘制窗口 */
export function hasOverlayPermission(): boolean

/** 打开系统的"显示在其他应用上层"授权页 */
export function requestOverlayPermission(): boolean

/**
 * 弹层弹出权限状态（JSON 字符串）：
 * {"miui":bool,"overlay":bool,"miuiPopup":int,"miuiPopupKnown":bool,"blocked":bool}
 * miui：是否小米/Redmi/POCO 设备，false 时页面不显示「后台弹出界面」项；
 * overlay：显示在其他应用上层；miuiPopup：MIUI「后台弹出界面」AppOp 10021（0 允许/1 忽略/2 拒绝/3 默认）；
 * known=false 表示系统不提供或隐藏 API 读取被拦截；blocked=true 表示最近 7 天实际拦截过弹层。
 */
export function getPopupPermissionState(): string

/** 打开 MIUI 的「后台弹出界面」权限编辑页；非 MIUI 退回应用详情页 */
export function openPopupPermissionSettings(): boolean

/** 设置支付后底部确认弹层的主题强调色（#RRGGBB，字面色——原生不认 CSS 变量），下次弹层生效 */
export function setCardThemeColor(color: string): boolean

/** 系统是否已对本应用豁免电池优化（true = 电池策略不限制） */
export function isIgnoringBatteryOptimizations(): boolean

/** 请求电池优化白名单，返回 {"success":bool,"granted":bool} JSON 字符串 */
export function requestIgnoreBatteryOptimizations(): string

/** 打开本应用系统详情页（国产 ROM 的自启动/后台管理入口） */
export function openAppSettings(): void

/** 手动记一笔（不走自动解析），返回 {"success":true,"id":n} JSON 字符串 */
export function saveManualBill(money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string): string

/**
 * 按指定日期记一笔（date 为 "YYYY-MM-DD"，空串取今天）
 * 返回 {"success":true,"id":n} JSON 字符串
 */
export function saveBillEx(date: string, money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string, reimb: boolean, starred: boolean): string

/**
 * 编辑已入账账单（保留来源与创建时间），date 为 "YYYY-MM-DD"
 * 返回 {"success":true} JSON 字符串
 */
export function updateBill(id: string, date: string, money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string, reimb: boolean, starred: boolean): string

/** 某月账单列表（含每笔完整字段），返回 JSON 数组字符串 */
export function getMonthBills(year: string, month: string): string

/** 某年账单列表（用于年维度统计），返回 JSON 数组字符串 */
export function getYearBills(year: string): string

/** 删除账单 */
export function deleteBill(id: string): boolean

/**
 * 调试用：把一段文本当作"支付成功"页面注入解析流水线，无需真实支付即可验证。
 * 文本需包含完成标记（如"支付成功"）与金额，返回结果 JSON 字符串。
 */
export function emitTestBill(text: string): string

// ---------- 钱迹 Excel 导入（本地解析，不联网） ----------

/** 拉起系统文件选择器选钱迹导出的 Excel，返回 {"success":bool,"error"?:string}；结果由 getImportPickState 轮询 */
export function openImportPicker(): string

/** 选文件状态：{"state":"idle|picking|picked|cancelled|error","path":"","name":"","error":""} */
export function getImportPickState(): string

/**
 * 读取钱迹 xlsx 的原始表格（不做账单语义解析）。
 * 返回 {"ok":true,"header":["ID","时间",…],"width":n,"total":n,"capped"?:true}；
 * 数据行由 getImportSheetRows 分块取回，再交给 common/qianji-import.js 解析。
 */
export function readImportSheet(path: string): string

/** 分块读取原始数据行（不含表头），返回 {"total":n,"rows":[["…"],…]} */
export function getImportSheetRows(offset: string, limit: string): string

/** 统计一组钱迹单号在库中已存在的条数，返回 {"count":n} JSON 字符串 */
export function countExistingOrders(orderNosJson: string): string

/** 批量入库（页面映射好的账单数组 JSON，金额带符号），按 orderNo 去重，返回 {"success","inserted","skipped"} */
export function commitImportBills(billsJson: string): string

// ---------- 本应用备份（导出 / 恢复） ----------

/** 拉起系统"另存为"保存备份文件，返回 {"success":bool,"error"?:string}；结果由 getBackupSaveState 轮询 */
export function openBackupExport(content: string, name: string): string

/** 导出状态：{"state":"idle|saving|saved|cancelled|error","name":"","error":""} */
export function getBackupSaveState(): string

/** 选择本应用备份 JSON，返回 {"success":bool,"error"?:string}；结果由 getImportPickState 轮询 */
export function openBackupPicker(): string

/** 读取备份文件文本（UTF-8），返回 {"ok":bool,"text":"","error"?:string} */
export function readBackupText(path: string): string

/** 按原 id 恢复账单（同 id / 同单号跳过），返回 {"success","inserted","skipped"} */
export function commitBackupBills(billsJson: string): string

/** 全量账单分页（导出用），offset/limit 为数字字符串，返回 {"total":n,"rows":[…]} */
export function getAllBills(offset: string, limit: string): string

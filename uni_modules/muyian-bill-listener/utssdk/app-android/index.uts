export function deleteBill(id: string): boolean {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return false;
  }
  return MuyianBillCore.deleteBill(c, id);
}

export function emitTestBill(text: string): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"accepted":false,"reason":"context is null"}';
  }
  return MuyianBillCore.emitTestBill(c, text);
}


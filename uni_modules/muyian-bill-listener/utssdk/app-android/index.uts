}

export function openAppSettings(): void {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return;
  }
  MuyianBillCore.openAppSettings(c);
}

export function saveManualBill(money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"success":false,"error":"context is null"}';
  }
  return MuyianBillCore.saveManualBill(c, money, isIncome, bankName, costType, orderRemark);
}

export function saveBillEx(date: string, money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string, reimb: boolean, starred: boolean): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"success":false,"error":"context is null"}';
  }
  return MuyianBillCore.saveBillEx(c, date, money, isIncome, bankName, costType, orderRemark, reimb, starred);
}

export function updateBill(id: string, date: string, money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string, reimb: boolean, starred: boolean): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {

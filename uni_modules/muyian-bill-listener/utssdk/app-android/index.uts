import Intent from "android.content.Intent";
import Settings from "android.provider.Settings";
import MuyianBillCore from "muyian.bill.listener.MuyianBillCore";
import { UTSAndroid } from "io.dcloud.uts";

/**
 * muyian-bill-listener：Android 平台实现。
 * 核心逻辑在 hybrid.kt（纯 Kotlin），本文件只做薄封装。
 * 所有 API 同步返回，复杂数据为 JSON 字符串。
 */

export function initBillListener(): void {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return;
  }
  MuyianBillCore.init(c);
}

export function isAccessibilityEnabled(): boolean {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return false;
  }
  return MuyianBillCore.isAccessibilityEnabled(c);
}

export function openAccessibilitySettings(): void {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return;
  }
  const intent = new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS);
  intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
  c.startActivity(intent);
}

export function getSelfRepairState(): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"hasPermission":false,"serviceEnabled":false,"packageName":""}';
  }
  return MuyianBillCore.getSelfRepairState(c);
}

export function repairAccessibilityService(): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"success":false,"error":"context is null"}';
  }
  return MuyianBillCore.repairAccessibilityService(c);
}

export function isNotificationListenerEnabled(): boolean {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return false;
  }
  return MuyianBillCore.isNotificationListenerEnabled(c);
}

export function openNotificationListenerSettings(): void {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return;
  }
  const intent = new Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS);
  intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
  c.startActivity(intent);
}

export function getPendingDrafts(): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return "[]";
  }
  return MuyianBillCore.getPendingDrafts(c);
}

export function getDraft(token: string): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return "";
  }
  return MuyianBillCore.getDraft(c, token);
}

export function resolveDraft(token: string, money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"success":false,"error":"context is null"}';
  }
  return MuyianBillCore.resolveDraft(c, token, money, isIncome, bankName, costType, orderRemark);
}

export function discardDraft(token: string): boolean {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return false;
  }
  return MuyianBillCore.discardDraft(c, token);
}

export function saveManualBill(money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"success":false,"error":"context is null"}';
  }
  return MuyianBillCore.saveManualBill(c, money, isIncome, bankName, costType, orderRemark);
}

export function saveBillEx(date: string, money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string, reimb: boolean, starred: boolean): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"success":false,"error":"context is null"}';
  }
  return MuyianBillCore.saveBillEx(c, date, money, isIncome, bankName, costType, orderRemark, reimb, starred);
}

export function updateBill(id: string, date: string, money: string, isIncome: boolean, bankName: string, costType: string, orderRemark: string, reimb: boolean, starred: boolean): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"success":false,"error":"context is null"}';
  }
  return MuyianBillCore.updateBill(c, id, date, money, isIncome, bankName, costType, orderRemark, reimb, starred);
}

export function getMonthBills(year: string, month: string): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return "[]";
  }
  return MuyianBillCore.getMonthBills(c, year, month);
}

export function getYearBills(year: string): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return "[]";
  }
  return MuyianBillCore.getYearBills(c, year);
}

export function deleteBill(id: string): boolean {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return false;
  }
  return MuyianBillCore.deleteBill(c, id);
}

export function emitTestBill(text: string): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"accepted":false,"reason":"context is null"}';
  }
  return MuyianBillCore.emitTestBill(c, text);
}

export function getPopupPermissionState(): string {
  const c = UTSAndroid.getAppContext();
  if (c == null) {
    return '{"miui":false,"overlay":false,"miuiPopup":-1,"miuiPopupKnown":false,"blocked":false}';
  }
  return MuyianBillCore.getPopupPermissionState(c);
}

